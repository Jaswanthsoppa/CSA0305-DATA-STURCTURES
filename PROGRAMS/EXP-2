#include <stdio.h>

int main() {
    int n, i, number;

    printf("How many numbers? ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        printf("Enter number %d: ", i);
        scanf("%d", &number);

        if (number % 2 == 0) {
            printf("%d is Even\n", number);
        } else {
            printf("%d is Odd\n", number);
        }
    }

    return 0;
}
